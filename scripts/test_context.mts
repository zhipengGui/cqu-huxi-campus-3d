import assert from 'node:assert/strict';
import { readFileSync } from 'node:fs';
import { Group } from 'three';
import { buildSportsMarks } from '../src/sports.ts';
import { campusAreas, distanceToCampus, clipRoads } from '../src/campusClip.ts';
const data=JSON.parse(readFileSync(new URL('../public/data/scene.json',import.meta.url),'utf8'));
const areas=campusAreas(data.green,data.boundary.pts);
assert.ok(!areas.some(a=>a.id===722690704),'unverified field 449m outside campus must be excluded');
assert.ok(areas.some(a=>a.sport==='basketball'),'retain mapped campus basketball courts');
const group=new Group();
buildSportsMarks(group,[{id:1,name:'',kind:'pitch',outers:[[[0,0],[120,0],[120,180],[0,180]]],inners:[]}]);
assert.equal(group.children.length,0,'an untyped large pitch is not evidence of a running track');
console.log('PASS exterior sports exclusion, campus courts retained, no area-based track guessing');
const boundary: [number,number][]=[[0,0],[1000,0],[1000,1000],[0,1000],[0,0]];
assert.equal(distanceToCampus([500,-50],boundary),50,'measure from edges, not only corner vertices');
assert.equal(distanceToCampus([500,500],boundary),0);
const road={id:1,kind:'service',name:'',width:4,pts:[[500,-500],[500,1500]] as [number,number][]};
const visible=clipRoads([road],boundary,200);
assert.ok(visible.length>0);
assert.ok(visible.every(r=>r.pts.every(p=>distanceToCampus(p,boundary)<=200.001)),'clip roads at the actual context limit');
assert.equal(road.pts[0][1],-500,'preserve original navigation inputs');
const corner=clipRoads([{...road,pts:[[-500,-500],[-50,-50]]}],boundary,200);
assert.ok(corner.length>0&&Math.abs(distanceToCampus(corner[0].pts[0],boundary)-200)<.001,'rounded buffer corners');
const {buildContext}=await import('../src/context.ts');
const context=buildContext(data);
let triangles=0,calls=0;
context.traverse(o=>{if(o.isMesh){calls++;triangles+=(o.geometry.index?.count??o.geometry.attributes.position.count)/3;assert.ok(!o.castShadow&&!o.receiveShadow);assert.ok(!o.userData.id&&!o.userData.pickRoot);}});
assert.ok(calls>0&&calls<=20&&triangles<=50000,'context must fit the approved geometry/draw budget');
assert.ok(context.userData.metrics.buildings>0&&context.userData.metrics.roadSegments>0);
const ground=context.getObjectByName('context-ground');
assert.ok(ground.geometry.attributes.normal.getY(0)>.9,'transition ground must face upward');
console.log('PASS edge-distance selection, buffered roads, immutable graph and context budget',context.userData.metrics);
